{
    "name": "akshar/backend",
    "description": "Akshar backend. Phase 004 ships the toolchain only; the Laravel skeleton lands in Phase 005.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "Akshar\\Backend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akshar\\Backend\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
