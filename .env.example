# AKSHAR environment contract — Phase 004
#
# Copy this file to the location noted below and fill in LOCAL DEV values only.
# NEVER commit a real .env. Secrets live outside the repository (DEPLOYMENT.md §8).

# ---------------------------------------------------------------------------
# Frontend (copy to frontend/.env) — consumed by Vite as import.meta.env.*
# Only VITE_* variables reach the browser bundle. Never place secrets here.
# ---------------------------------------------------------------------------
# Base URL of the Laravel API (empty = same-origin in production)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Backend (future: backend/.env once the Laravel skeleton exists — Phase 005+)
# Values below are the contract placeholders; nothing reads them yet.
# ---------------------------------------------------------------------------
APP_NAME=Akshar
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=akshar
DB_USERNAME=akshar
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@localhost
