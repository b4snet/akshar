# AKSHAR environment contract — Phase 006
#
# This is the annotated REFERENCE for environment variables across the stack.
# The runnable per-app templates are backend/.env.example (Laravel) and the
# frontend block below. The machine-enforced definition lives in
# scripts/env-contract.mjs — run `npm run env:check` to validate.
#
# NEVER commit a real .env. Secret values live outside the repository
# (docs/DEPLOYMENT.md §8). Local defaults below are dev-only and must be
# replaced in CI/staging/production via external secret configuration.

# ---------------------------------------------------------------------------
# Frontend (copy relevant lines to frontend/.env) — consumed by Vite as
# import.meta.env.*. Only VITE_* variables reach the browser bundle; never
# place secrets there.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Backend (copy to backend/.env, then run: php backend/artisan key:generate)
# Values below match infrastructure/compose.dev.yaml and backend/.env.example.
# ---------------------------------------------------------------------------
APP_NAME=Akshar
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=akshar
DB_USERNAME=akshar
DB_PASSWORD=secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Object storage stays production-shaped here for later phases; the local
# backend baseline uses FILESYSTEM_DISK=local (see backend/.env.example).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@localhost

# ---------------------------------------------------------------------------
# Local services (infrastructure/compose.dev.yaml overrides; optional)
# ---------------------------------------------------------------------------
# POSTGRES_DB=akshar
# POSTGRES_USER=akshar
# POSTGRES_PASSWORD=secret
# POSTGRES_PORT=5432
# REDIS_PORT=6379
